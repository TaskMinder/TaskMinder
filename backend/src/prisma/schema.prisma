generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  accountId     Int             @id @default(autoincrement()) @map("accountId")
  username      String
  password      String
  deletedAt     BigInt?
  createdAt     BigInt?
  bannedAt      BigInt?
  banReason     String?

  HomeworkCheck HomeworkCheck[]
  JoinedClass   JoinedClass?
  JoinedTeams   JoinedTeams[]
  Files         Upload[]
  // personal (account-scoped) homework and events; null accountId on these models means shared
  Homework      Homework[]
  Event         Event[]
  // private authorship of shared and personal items, never returned in API responses
  CreatedHomework    Homework[] @relation("HomeworkCreatedBy")
  EditedHomework     Homework[] @relation("HomeworkLastEditedBy")
  CreatedEvents      Event[]    @relation("EventCreatedBy")
  EditedEvents       Event[]    @relation("EventLastEditedBy")
  ReportsAgainst     Report[]   @relation("ReportTargetAccount")
  ReportsFiled       Report[]   @relation("ReportReporterAccount")
  Blocks             Block[]    @relation("Blocker")
  BlockedBy          Block[]    @relation("Blocked")
  ModerationNotices  ModerationNotice[]

  // FIXME: account_username_unique_active_key partial index for
  // deletedAt and username; manual migration in: improve_schema 20251121
  // prisma v7 implemented this as a preview feature, wait until it's stable
  @@index([deletedAt])
  @@map("account")
}

model Event {
  eventId     Int       @id @default(autoincrement()) @map("eventId")
  classId     Int
  eventTypeId Int
  isPinned    Boolean
  name        String
  description String?
  startDate   BigInt
  endDate     BigInt?
  lesson      String?
  teamId      Int
  // null = shared (team-scoped) event; set = personal event owned by this account
  accountId   Int?
  createdAt   BigInt?
  createdByAccountId    Int?
  lastEditedByAccountId Int?

  EventType   EventType @relation(fields: [eventTypeId], references: [eventTypeId], onDelete: Cascade, onUpdate: NoAction)
  Class       Class     @relation(fields: [classId], references: [classId], onDelete: Cascade, onUpdate: NoAction)
  Account     Account?  @relation(fields: [accountId], references: [accountId], onDelete: Cascade, onUpdate: NoAction)
  CreatedBy    Account? @relation("EventCreatedBy", fields: [createdByAccountId], references: [accountId], onDelete: SetNull, onUpdate: NoAction)
  LastEditedBy Account? @relation("EventLastEditedBy", fields: [lastEditedByAccountId], references: [accountId], onDelete: SetNull, onUpdate: NoAction)

  @@index([classId])
  @@index([teamId])
  @@index([startDate, classId])
  @@index([classId, isPinned, startDate])
  @@index([classId, accountId])
  @@map("event")
}

model EventType {
  eventTypeId Int     @id @default(autoincrement()) @map("eventTypeId")
  classId     Int
  name        String
  color       String?
  createdAt   BigInt?

  Event       Event[]

  Class       Class   @relation(fields: [classId], references: [classId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([classId, name])
  @@map("eventType")
}

model Class {
  classId                 Int           @id @default(autoincrement()) @map("classId")
  className               String
  classCode               String        @unique
  classCodeHash           String        @unique
  createdAt               BigInt
  isTestClass             Boolean
  defaultPermissionLevel  Int
  storageUsedBytes        BigInt
  // total storage quota (bytes)
  storageQuotaBytes       BigInt
  dsbMobileActivated      Boolean
  dsbMobileUser           String?
  dsbMobilePassword       String?
  // real name of class to filter in substitution data
  dsbMobileClass          String?

  Event                   Event[]
  EventType               EventType[]
  Homework                Homework[]
  JoinedClass             JoinedClass[]
  Lesson                  Lesson[]
  Subjects                Subjects[]
  Team                    Team[]
  Files                   Upload[]
  UploadRequest           UploadRequest[]
  Report                  Report[]

  @@index([isTestClass, createdAt])
  @@map("class")
}

model Homework {
  homeworkId     Int             @id @default(autoincrement()) @map("homeworkId")
  classId        Int
  isPinned       Boolean
  content        String
  subjectId      Int
  assignmentDate BigInt
  submissionDate BigInt
  teamId         Int
  // null = shared (team-scoped) homework; set = personal homework owned by this account
  accountId      Int?
  createdAt      BigInt?
  createdByAccountId    Int?
  lastEditedByAccountId Int?

  HomeworkCheck  HomeworkCheck[]

  Class          Class           @relation(fields: [classId], references: [classId], onDelete: Cascade, onUpdate: NoAction)
  Account        Account?        @relation(fields: [accountId], references: [accountId], onDelete: Cascade, onUpdate: NoAction)
  CreatedBy      Account?        @relation("HomeworkCreatedBy", fields: [createdByAccountId], references: [accountId], onDelete: SetNull, onUpdate: NoAction)
  LastEditedBy   Account?        @relation("HomeworkLastEditedBy", fields: [lastEditedByAccountId], references: [accountId], onDelete: SetNull, onUpdate: NoAction)

  @@index([classId])
  @@index([teamId])
  @@index([submissionDate, classId])
  @@index([classId, isPinned, submissionDate])
  @@index([classId, accountId])
  @@map("homework")
}

model HomeworkCheck {
  checkId    Int      @id @default(autoincrement()) @map("checkId")
  accountId  Int
  homeworkId Int
  createdAt  BigInt?

  Account    Account  @relation(fields: [accountId], references: [accountId], onDelete: Cascade, onUpdate: NoAction)
  Homework   Homework @relation(fields: [homeworkId], references: [homeworkId], onDelete: Cascade, onUpdate: NoAction)

  @@index([accountId])
  @@unique([accountId, homeworkId], map: "homework_check_account_id_homework_id")
  @@map("homeworkCheck")
}

model JoinedClass {
  joinedClassId   Int     @id @default(autoincrement()) @map("joinedClassId")
  classId         Int
  accountId       Int     @unique
  permissionLevel Int
  createdAt       BigInt?

  Account         Account @relation(fields: [accountId], references: [accountId], onDelete: Cascade, onUpdate: NoAction)
  Class           Class   @relation(fields: [classId], references: [classId], onDelete: Cascade, onUpdate: NoAction)

  @@index([classId])
  @@map("joinedClass")
}

model JoinedTeams {
  joinedTeamId Int     @id @default(autoincrement()) @map("joinedTeamId")
  teamId       Int
  accountId    Int
  createdAt    BigInt?

  Account      Account @relation(fields: [accountId], references: [accountId], onDelete: Cascade, onUpdate: NoAction)
  Team         Team    @relation(fields: [teamId], references: [teamId], onDelete: Cascade, onUpdate: NoAction)

  @@index([accountId])
  @@unique([teamId, accountId], map: "joined_teams_team_id_account_id")
  @@map("joinedTeams")
}

model Lesson {
  lessonId     Int    @id @default(autoincrement()) @map("lessonId")
  classId      Int
  lessonNumber Int
  weekDay      Int
  teamId       Int
  subjectId    Int
  room         String
  startTime    BigInt
  endTime      BigInt
  createdAt    BigInt?

  Class        Class  @relation(fields: [classId], references: [classId], onDelete: Cascade, onUpdate: NoAction)

  @@index([classId])
  @@index([teamId])
  @@unique([classId, teamId, weekDay, lessonNumber, subjectId])
  @@map("lesson")
}

model Subjects {
  subjectId               Int      @id @default(autoincrement()) @map("subjectId")
  classId                 Int
  subjectNameLong         String
  subjectNameShort        String
  subjectNameSubstitution String[]
  teacherGender           String
  teacherNameLong         String
  teacherNameShort        String
  teacherNameSubstitution String[]
  teamId                  Int
  createdAt               BigInt?

  Class                   Class    @relation(fields: [classId], references: [classId], onDelete: Cascade, onUpdate: NoAction)

  @@index([classId])
  @@index([teamId])
  @@map("subjects")
}

model Team {
  teamId      Int           @id @default(autoincrement()) @map("teamId")
  classId     Int
  name        String
  createdAt   BigInt?

  JoinedTeams JoinedTeams[]

  Class       Class         @relation(fields: [classId], references: [classId], onDelete: Cascade, onUpdate: NoAction)

  @@index([classId])
  @@unique([classId, name])
  @@map("team")
}

model FileMetadata {
  fileMetaDataId   Int    @id @default(autoincrement())
  uploadId         Int
  storedFileName   String   @unique // unique UUID name on disk
  mimeType         String
  size             Int
  createdAt        BigInt

  Upload Upload @relation(fields: [uploadId], references: [uploadId], onDelete: Cascade, onUpdate: NoAction)
  @@index([uploadId])
  @@map("fileMetadata")
}

// an upload can contain one or multiple files
model Upload {
  uploadId            Int    @id @default(autoincrement())
  uploadName          String 
  uploadDescription   String?
  uploadType          String
  isPinned            Boolean
  status              String @default("queued") // "queued" | "processing" | "completed" | "failed"
  errorReason         String?
  reservedBytes       BigInt @default(0) // Storage reserved during upload
  createdAt           BigInt  // When the upload job was created

  teamId              Int
  accountId           Int?
  classId             Int

  Files               FileMetadata[]

  Account             Account?   @relation(fields: [accountId], references: [accountId], onDelete: SetNull, onUpdate: NoAction)
  Class               Class      @relation(fields: [classId], references: [classId], onDelete: Cascade, onUpdate: NoAction)

  @@index([classId])
  @@index([teamId])
  @@index([classId, teamId, createdAt])
  @@index([classId, isPinned(sort: Desc), createdAt(sort: Desc), uploadName, uploadId(sort: Desc)])
  @@index([status, createdAt])
  @@map("upload")
}

model UploadRequest {
  uploadRequestId     Int        @id @default(autoincrement())
  uploadRequestName   String
  classId             Int
  teamId              Int

  Class               Class      @relation(fields: [classId], references: [classId], onDelete: Cascade, onUpdate: NoAction)

  @@index([classId])
  @@index([teamId])
  @@map("uploadRequest")
}

model Report {
  reportId          Int      @id @default(autoincrement())
  classId           Int?
  targetType        String   // "homework" | "event" | "upload" | "account" | "class"
  targetId          Int
  // author at report time (lastEditedBy ?? createdBy, the uploader or the reported account)
  targetAccountId   Int?
  reporterAccountId Int?
  // account id or hash of the session id, used for dedupe
  reporterKey       String
  // optional email, encrypted with the encryption manager
  reporterContact   String?
  category          String   // "illegal" | "harassment" | "hate" | "sexual" | "spam" | "privacy" | "other" | "block"
  description       String?
  // content at report time, never file bytes
  snapshot          Json
  status            String   @default("open") // "open" | "resolved"
  action            String?  // "dismiss" | "remove" | "ban" | "remove_and_ban" | "rotate_class_code"
  decisionReason    String?
  resolvedAt        BigInt?
  createdAt         BigInt

  Class             Class?   @relation(fields: [classId], references: [classId], onDelete: SetNull, onUpdate: NoAction)
  TargetAccount     Account? @relation("ReportTargetAccount", fields: [targetAccountId], references: [accountId], onDelete: SetNull, onUpdate: NoAction)
  ReporterAccount   Account? @relation("ReportReporterAccount", fields: [reporterAccountId], references: [accountId], onDelete: SetNull, onUpdate: NoAction)

  @@index([targetType, targetId])
  @@index([targetAccountId])
  @@index([status, resolvedAt])
  @@map("report")
}

model Block {
  blockId          Int     @id @default(autoincrement())
  // the blocker
  accountId        Int
  blockedAccountId Int
  createdAt        BigInt

  Account          Account @relation("Blocker", fields: [accountId], references: [accountId], onDelete: Cascade, onUpdate: NoAction)
  BlockedAccount   Account @relation("Blocked", fields: [blockedAccountId], references: [accountId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([accountId, blockedAccountId])
  @@map("block")
}

model ModerationNotice {
  noticeId   Int     @id @default(autoincrement())
  accountId  Int
  action     String  // "remove" | "remove_and_ban"
  targetType String
  reason     String
  createdAt  BigInt
  seenAt     BigInt?

  Account    Account @relation(fields: [accountId], references: [accountId], onDelete: Cascade, onUpdate: NoAction)

  @@index([accountId])
  @@map("moderationNotice")
}
