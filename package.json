{
  "name": "taskminder",
  "version": "2.3.1",
  "description": "",
  "main": "backend/dist/server.js",
  "scripts": {
    "test": "echo \"no test specified, passing anyway (for now)\" && exit 0",
    "lint:prisma": "oxlint backend/src",
    "lint:eslint": "eslint --fix .",
    "lint:prettier": "prettier --write 'frontend/src/**/*.html'",
    "lint": "bun run lint:prisma && bun run lint:eslint && bun run lint:prettier",
    "build:be": "bun run build:be:copy && bun run build:be:tsc",
    "build:be:tsc": "tsc -p backend",
    "build:be:copy": "bun copyFiles.js backend/src backend/dist",
    "build:fe": "bun run build:fe:copy && bun run build:fe:html && bun run build:fe:scss && bun run build:fe:tsc",
    "build:fe:html": "bun frontend/buildHtml.js frontend/src frontend/dist",
    "build:fe:scss": "sass frontend/src:frontend/dist --no-source-map --style=compressed",
    "build:fe:tsc": "bun run build:fe:tsc:app && bun run build:fe:tsc:sw",
    "build:fe:tsc:app": "tsc -p frontend/tsconfig.json",
    "build:fe:tsc:sw": "tsc -p frontend/tsconfig.sw.json",
    "build:fe:copy": "bun copyFiles.js frontend/src frontend/dist",
    "build": "bun run build:fe && bun run build:be",
    "dev:server": "bun --watch backend/dist/server.js",
    "dev:be": "concurrently -n 'copy,tsc' \"bun run dev:be:copy\" \"bun run dev:be:tsc\"",
    "dev:be:tsc": "tsc -p backend --watch --incremental",
    "dev:be:copy": "chokidar 'backend/src/**/*' -c 'bun copyFiles.js backend/src backend/dist'",
    "dev:fe": "concurrently -n 'copy,html,scss,tsc' \"bun run dev:fe:copy\" \"bun run dev:fe:html\" \"bun run dev:fe:scss\" \"bun run dev:fe:tsc\"",
    "dev:fe:html": "chokidar 'frontend/src/**/*.html' 'frontend/buildHtml.js' -c 'bun frontend/buildHtml.js frontend/src frontend/dist'",
    "dev:fe:scss": "sass frontend/src:frontend/dist --watch --no-source-map --style=compressed",
    "dev:fe:tsc": "concurrently -n 'app,sw' \"bun run dev:fe:tsc:app\" \"bun run dev:fe:tsc:sw\"",
    "dev:fe:tsc:app": "tsc -p frontend --watch --incremental",
    "dev:fe:tsc:sw": "tsc -p frontend/tsconfig.sw.json --watch --incremental",
    "dev:fe:copy": "chokidar 'frontend/src/**/*' -c 'bun copyFiles.js frontend/src frontend/dist'",
    "dev:start": "concurrently -n 'backend,frontend,server' \"bun run dev:be\" \"bun run dev:fe\" \"bun run dev:server\"",
    "dev": "bun run dev:start",
    "dev-build": "bun run build && bun run dev:start",
    "encrypt:rotate": "bun backend/dist/utils/encryption.rotate.js"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcrypt": "6.0.0",
    "bootstrap": "5.3.8",
    "chalk": "6.0.0",
    "cheerio": "1.2.0",
    "chokidar": "5.0.0",
    "chokidar-cli": "3.0.0",
    "concurrently": "10.0.5",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "file-type": "22.1.0",
    "fs-extra": "11.4.0",
    "helmet": "8.3.0",
    "iconv-lite": "0.7.3",
    "jquery": "4.0.0",
    "mime-types": "3.0.2",
    "multer": "2.4.0",
    "node-cron": "4.6.0",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "redis": "6.2.1",
    "sass": "1.104.1",
    "sharp": "0.35.4",
    "socket.io": "4.8.3",
    "winston": "3.19.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bcrypt": "6.0.0",
    "@types/bootstrap": "5.2.11",
    "@types/bun": "1.4.2",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/jquery": "4.0.1",
    "@types/mime-types": "3.0.1",
    "@types/multer": "2.2.0",
    "@types/node-cron": "3.0.11",
    "@types/qrcode": "1.5.6",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "oxlint": "1.83.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "private": true
}
