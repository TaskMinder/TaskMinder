# proxy hop number for reverse proxies (in development, set to 1)
PROXY_HOP=2

# cache enabled setting (development only)
CACHE_ENABLED=false # recommended to false in dev

# DEVELOPMENT in development (PRODUCTION in production)
NODE_ENV=DEVELOPMENT

# session secret
SESSION_SECRET=session_value

# encryption key (openssl rand -base64 32)
ENCRYPTION_KEY=base64_32_bytes
# secondary key used for rotation/decryption
ENCRYPTION_KEY_SECONDARY=base64_32_bytes
# stable lookup key for hashing (keep constant across rotations)
ENCRYPTION_KEY_LOOKUP=base64_32_bytes

# database URL for prisma ORM
DATABASE_URL="postgresql://db_user:db_pwd@localhost:5432/db_name?schema=public"

# resend api key for moderation mails (optional in development, mails are logged instead)
RESEND_API_KEY=
# secret for signed moderation review links (openssl rand -base64 32)
MODERATION_LINK_SECRET=secret_value
# operator inbox for new reports, also shown to banned users as support contact
MODERATION_EMAIL_TO=moderation@example.com
# sender address (verified resend domain)
MODERATION_EMAIL_FROM=noreply@example.com
# public base url used in review links
PUBLIC_BASE_URL=http://localhost:3000